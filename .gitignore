# Python bytecode / caches
__pycache__/
*.py[cod]
*$py.class
*.so

# Test / type / lint caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# Packaging / coverage artifacts
*.egg-info/
.coverage
htmlcov/
dist/
build/

# IDE / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Scanner output.
# These are regenerated on every run, so tracking them makes the working tree
# dirty after each scan and produces a merge conflict per branch. Stable
# copies for the README live in examples/*.sample.json.
scan_report.json
sbom.json
_base_sbom.json
aibom-guard.sarif
artifacts/
*.log

# Local model / Hub caches
.cache/
.aibom-guard/

# Accidental sdist unpack leftovers
aibom_guard-*/
